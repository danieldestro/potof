# Copie este arquivo para .env e preencha os valores localmente.
# Em produção (Railway), configure essas mesmas variáveis no painel do projeto —
# o .env não é usado lá, apenas em desenvolvimento local (ver backend/package.json).

# Liga/desliga o botão de efeitos com IA no visualizador de fotos.
FEATURE_AI_PHOTO_EDIT=false

# Provedor usado para gerar os efeitos: "openai" ou "gemini".
AI_PROVIDER=openai

# Necessário apenas se AI_PROVIDER=openai.
OPENAI_API_KEY=

# Necessário apenas se AI_PROVIDER=gemini.
GEMINI_API_KEY=
