generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Provedor de fotos/eventos. "proprio=true" identifica o(s) provedor(es) cujos
// eventos/fotos são armazenados e servidos localmente (BD próprio); os demais
// (ex: Fotop) são fontes externas acessadas via adapter específico (fase futura).
model Provedor {
  id          Int      @id @default(autoincrement())
  // Chave estável usada pelo registry de adapters (backend/src/providers/registry.ts)
  // pra resolver qual implementação usar — "nome" é texto livre editável no admin,
  // não serve pra isso.
  slug        String   @unique
  nome        String   @unique
  descricao   String?  @db.Text
  urlSite     String?  @map("url_site")
  ativo       Boolean  @default(true)
  proprio     Boolean  @default(false)

  // Preenchidos pelo sync (manual ou automático — ver backend/src/providers/scheduler.ts)
  // sempre que ele roda pra este provedor, com sucesso ou falha.
  ultimaSincronizacaoEm        DateTime? @map("ultima_sincronizacao_em")
  ultimaSincronizacaoResultado String?   @map("ultima_sincronizacao_resultado") @db.Text

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  eventos              Evento[]
  categoriasProvedores CategoriaProvedor[]

  @@map("provedores")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nome      String
  descricao String?  @db.Text
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  eventos              Evento[]
  categoriasProvedores CategoriaProvedor[]

  @@map("categorias")
}

// Mapeia a categoria própria para o id que cada provedor externo usa pra
// classificar o mesmo tipo de evento (ex: fotop's id_estacoes) — necessário
// pro futuro sync/adapter de eventos saber a que Categoria local um evento
// importado de um provedor pertence.
model CategoriaProvedor {
  id                  Int       @id @default(autoincrement())
  categoriaId         Int       @map("categoria_id")
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  provedorId          Int       @map("provedor_id")
  provedor            Provedor  @relation(fields: [provedorId], references: [id])
  idCategoriaProvedor String    @map("id_categoria_provedor")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Sem unicidade em (categoria_id, provedor_id): uma mesma categoria local pode ter N ids
  // diferentes mapeados pro mesmo provedor (sinônimos do catálogo do provedor — ex: Foco Radical
  // tem "Beach Tennis" com os ids 76/173/40 todos apontando pra mesma Categoria local). O que não
  // pode é um id de categoria de um provedor apontar pra mais de uma categoria local — daí a
  // unicidade ficar só em (provedor_id, id_categoria_provedor).
  @@unique([provedorId, idCategoriaProvedor])
  @@map("categorias_provedores")
}

model Evento {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?  @db.Text
  local       String?
  dataHora    DateTime @map("data_hora")
  cidade      String?
  uf          String?
  pais        String?  @default("BR")

  categoriaId Int       @map("categoria_id")
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  searchSelfie Boolean @default(false) @map("search_selfie")
  searchBib    Boolean @default(false) @map("search_bib")
  searchName   Boolean @default(false) @map("search_name")

  provedorId       Int      @map("provedor_id")
  provedor         Provedor @relation(fields: [provedorId], references: [id])
  idEventoProvedor String?  @map("id_evento_provedor")

  urlSite   String?  @map("url_site")
  // VARCHAR(191) (o padrão do Prisma) estourou com URLs de capa do Foco Radical baseadas no
  // nome original do arquivo enviado pelo organizador do evento — não tem tamanho previsível.
  urlCapa   String?  @db.VarChar(500) @map("url_capa")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fotos Foto[]

  // Evita duplicar o mesmo evento de um provedor externo se ele for
  // resincronizado; não se aplica a eventos próprios (idEventoProvedor nulo).
  @@unique([provedorId, idEventoProvedor])
  @@map("eventos")
}

enum Perfil {
  admin
  user
}

// Tabela única para clientes/participantes e para quem acessa o backoffice
// (perfil=admin) — sem tabela separada de admin. senhaHash só é setado pra
// quem efetivamente faz login (hoje só perfil=admin; login de cliente é
// trabalho futuro). Nunca é devolvido pela API — ver o `omit` global em
// backend/src/db/prisma.ts.
model Usuario {
  id             Int       @id @default(autoincrement())
  nome           String
  email          String    @unique
  cpf            String?   @unique
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  cidade         String?
  uf             String?
  pais           String?   @default("BR")
  perfil         Perfil    @default(user)
  senhaHash      String?   @map("senha_hash")
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  fotografo Fotografo?

  @@map("usuarios")
}

model Fotografo {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fotos Foto[]

  @@map("fotografos")
}

model Foto {
  id          Int       @id @default(autoincrement())
  eventoId    Int       @map("evento_id")
  evento      Evento    @relation(fields: [eventoId], references: [id])
  fotografoId Int       @map("fotografo_id")
  fotografo   Fotografo @relation(fields: [fotografoId], references: [id])
  urlFoto     String    @map("url_foto")
  urlThumb    String?   @map("url_thumb")
  takenAt     DateTime? @map("taken_at")
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("fotos")
}
